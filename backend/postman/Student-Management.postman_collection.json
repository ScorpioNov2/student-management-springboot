{
  "info": {
    "_postman_id": "c48ed6c8-6045-4e40-a517-4f8e1a3bf003",
    "name": "Student Management API",
    "description": "API demo collection for registration, login, refresh-token rotation, student search and CRUD with USER and ADMIN roles. Public registration always creates USER. To promote the demo admin in SQLite run: UPDATE users SET role = 'ADMIN' WHERE username = '<adminUsername>'; for PostgreSQL run the same statement in the configured database. Then run Login ADMIN.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "userAccessToken",
      "value": ""
    },
    {
      "key": "userRefreshToken",
      "value": ""
    },
    {
      "key": "adminAccessToken",
      "value": ""
    },
    {
      "key": "adminRefreshToken",
      "value": ""
    },
    {
      "key": "studentId",
      "value": ""
    },
    {
      "key": "userUsername",
      "value": ""
    },
    {
      "key": "userEmail",
      "value": ""
    },
    {
      "key": "userPassword",
      "value": "StrongPassword123!"
    },
    {
      "key": "adminUsername",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": "StrongAdminPassword123!"
    },
    {
      "key": "uniqueIsuId",
      "value": "654321"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register USER",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{userUsername}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now();",
                  "pm.collectionVariables.set('userUsername', 'demo-user-' + suffix);",
                  "pm.collectionVariables.set('userEmail', 'demo-user-' + suffix + '@example.test');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Public registration creates USER', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.user.role).to.eql('USER');",
                  "  pm.collectionVariables.set('userAccessToken', body.accessToken);",
                  "  pm.collectionVariables.set('userRefreshToken', body.refreshToken);",
                  "pm.collectionVariables.set('userUsername', body.user.username);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login USER (username or email)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{userUsername}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "description": "Runs after Register USER; credentials are stored in collection variables.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('USER login succeeds', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.user.role).to.eql('USER');",
                  "  pm.collectionVariables.set('userAccessToken', body.accessToken);",
                  "  pm.collectionVariables.set('userRefreshToken', body.refreshToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh USER tokens",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{userRefreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/refresh"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Refresh rotates tokens', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.refreshToken).not.to.eql(pm.collectionVariables.get('userRefreshToken'));",
                  "  pm.collectionVariables.set('userAccessToken', body.accessToken);",
                  "  pm.collectionVariables.set('userRefreshToken', body.refreshToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register ADMIN account (starts as USER)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "description": "Public signup never grants ADMIN. The generated adminUsername is stored as a collection variable. Promote it using the SQL in the collection description, then use Login ADMIN.",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now();",
                  "pm.collectionVariables.set('adminUsername', 'demo-admin-' + suffix);",
                  "pm.collectionVariables.set('adminEmail', 'demo-admin-' + suffix + '@example.test');"
                ]
              }
            }
          ]
        },
        {
          "name": "Login ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "description": "Login after promoting the account in the database.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ADMIN login succeeds after promotion', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.user.role).to.eql('ADMIN');",
                  "  pm.collectionVariables.set('adminAccessToken', body.accessToken);",
                  "  pm.collectionVariables.set('adminRefreshToken', body.refreshToken);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Students - USER (read-only)",
      "item": [
        {
          "name": "QUERY students (search, filter, sort, paginate)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/students?search=Ivan&page=0&size=10&sortBy=fullName&sortDirection=asc"
          }
        },
        {
          "name": "Get student by id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/students/{{studentId}}"
          }
        },
        {
          "name": "Create is forbidden for USER",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Alex Ivanov\",\n  \"groupName\": \"B-1\",\n  \"isuId\": 654322,\n  \"dormitoryNumber\": 2,\n  \"roomNumber\": \"101\",\n  \"settlementTerm\": \"2027-05-31\",\n  \"foreigner\": false,\n  \"notes\": \"\"\n}"
            },
            "url": "{{baseUrl}}/api/students"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('USER cannot create students', function () {",
                  "  pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update is forbidden for USER",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomNumber\": \"999\"\n}"
            },
            "url": "{{baseUrl}}/api/students/{{studentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('USER cannot update students', function () {",
                  "  pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete is forbidden for USER",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/students/{{studentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('USER cannot delete students', function () {",
                  "  pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Students - ADMIN (full access)",
      "item": [
        {
          "name": "QUERY students with filters",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/students?fullName=Alex&groupName=B-1&foreigner=false&page=0&size=20&sortBy=id&sortDirection=desc"
          }
        },
        {
          "name": "Create student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Alex Ivanov\",\n  \"groupName\": \"B-1\",\n  \"isuId\": {{uniqueIsuId}},\n  \"dormitoryNumber\": 2,\n  \"roomNumber\": \"101\",\n  \"settlementTerm\": \"2027-05-31\",\n  \"foreigner\": false,\n  \"notes\": \"Postman demo student\"\n}"
            },
            "url": "{{baseUrl}}/api/students"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Student created', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.collectionVariables.set('studentId', pm.response.json().id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get student by id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/students/{{studentId}}"
          }
        },
        {
          "name": "PATCH student",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomNumber\": \"202\",\n  \"notes\": \"Updated by Postman\"\n}"
            },
            "url": "{{baseUrl}}/api/students/{{studentId}}"
          }
        },
        {
          "name": "DELETE student",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/students/{{studentId}}"
          }
        }
      ]
    }
  ]
}
